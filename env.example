# ZoRek Entertainment Bot - Environment Variables
# Copy this file to .env and fill in your actual API keys

# OMDb API Key (Required for movie suggestions)
# Get your key from: http://www.omdbapi.com/apikey.aspx
OMDB_KEY=your_omdb_key_here

# TMDB API Key (Required for movie genre filtering and now-playing movies)
# Get your key from: https://www.themoviedb.org/settings/api
TMDB_KEY=your_tmdb_key_here

# Spoonacular API Key (Required for food/recipe suggestions)
# Get your key from: https://spoonacular.com/food-api
SPOONACULAR_KEY=your_spoonacular_key_here

# Sheet.best URL (Required for logging interactions to Google Sheets)
# Get your URL from: https://sheet.best/
SHEET_BEST_URL=https://api.sheetbest.com/sheets/your_sheet_id_here

# Spotify OAuth (Optional but recommended for music suggestions)
# Get your credentials from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=https://zorek.onrender.com/oauth/spotify/callback

# SeatGeek Client ID (Optional for event booking)
# Get your ID from: https://seatgeek.com/account/develop
SEATGEEK_CLIENT_ID=your_seatgeek_client_id_here

# OpenAI API Key (Optional for AI commentary)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

