response = Map();
mainOptions = {"Suggest Something","Book an Event","My Pick Combo","Connect to Spotify","Connect with human"};

// extract error code from failure cause
code = 0;
if(cause != null && cause.containsKey("code"))
{
	try
	{
		code = cause.get("code").toNumber();
	}
	catch(e)
	{
		code = 0;
	}
}

// handle forward action failures
if(failed_response != null && failed_response.containsKey("action") && failed_response.get("action").toString().equalsIgnoreCase("forward"))
{
	if(code == 1001)
	{
		response.put("action","reply");
		response.put("replies",{"Looks like we are currently offline.","Drop us a message and we will reach out soon."});
		response.put("suggestions",mainOptions);
		return response;
	}
	else if(code == 1002)
	{
		response.put("action","reply");
		response.put("replies",{"All our agents are busy at the moment.","Please leave your request and we will get back shortly."});
		response.put("suggestions",mainOptions);
		return response;
	}
	else if(code == 1003)
	{
		response.put("action","reply");
		response.put("replies",{"We couldn't reach the operator right now.","Please try connecting again in a moment."});
		response.put("suggestions",mainOptions);
		return response;
	}
}

// handle reply execution errors
if(code == 1005)
{
	response.put("action","reply");
	response.put("replies",{"My reply seems too long to send.","Could you rephrase or try another option?"});
	response.put("suggestions",mainOptions);
	return response;
}
else if(code == 1007)
{
	response.put("action","reply");
	response.put("replies",{"I ran into a temporary issue executing that step.","Please try the previous option again."});
	response.put("suggestions",mainOptions);
	return response;
}

// generic error fallback
response.put("action","reply");
response.put("replies",{"Sorry, something went wrong. Please try again later."});
response.put("suggestions",mainOptions);
return response;
