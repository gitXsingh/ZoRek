info "📋 ContextHandler invoked with context_id: " + context_id;
info "📋 ContextHandler answers: " + answers;

response = Map();
hasReturned = false;

// ---------------- Suggest Something ----------------
if(context_id.equals("suggest_context"))
{
	try
	{
		info "🟦 suggest_context answers " + answers;
		category = "";
		if(answers != null && answers.containsKey("category"))
		{
			categoryAnswer = answers.get("category");
			if(categoryAnswer != null)
			{
				try
				{
					category = categoryAnswer.get("text").toString();
				}
				catch(catErr)
				{
					category = categoryAnswer.toString();
				}
			}
		}

		info "🟦 suggest_context category " + category;

		if(category != null)
		{
			categoryLower = category.toLowerCase();
			if(categoryLower.contains("movie") || categoryLower.contains("film") || categoryLower.contains("cinema"))
			{
				category = "movies";
			}
			else if(categoryLower.contains("book") || categoryLower.contains("novel") || categoryLower.contains("read"))
			{
				category = "books";
			}
			else if(categoryLower.contains("game") || categoryLower.contains("play"))
			{
				category = "games";
			}
			else if(categoryLower.contains("food") || categoryLower.contains("recipe") || categoryLower.contains("dish"))
			{
				category = "food";
			}
			else if(categoryLower.contains("music") || categoryLower.contains("song") || categoryLower.contains("playlist"))
			{
				category = "music";
			}
			else if(categoryLower.contains("surprise"))
			{
				randomChoices = {"movies","books","games","food","music"};
				randomIndex = zoho.currenttime.toLong() % randomChoices.size();
				category = randomChoices.get(randomIndex);
				info "🟦 suggest_context surprise mapped to " + category;
			}
		}

		if(category == "" || category == null)
		{
			response = Map();
			response.put("action","reply");
			response.put("replies",{"Please choose a category to continue."});
			response.put("suggestions",{"Movies","Books","Games","Food","Music"});
			hasReturned = true;
			return response;
		}

		// Check if preferences have been collected - if not, ask for them first
		genre = "";
		minImdb = "";
		year = "";
		subject = "";
		keyword = "";
		diet = "";
		songType = "";
		
		if(answers != null)
		{
			if(answers.containsKey("genre"))
			{
				try
				{
					genreAns = answers.get("genre");
					if(genreAns != null)
					{
						genre = genreAns.get("text").toString();
					}
				}
				catch(genErr)
				{
					if(answers.get("genre") != null)
					{
						genre = answers.get("genre").toString();
					}
				}
			}
			if(answers.containsKey("minImdb"))
			{
				try
				{
					ratingAns = answers.get("minImdb");
					if(ratingAns != null)
					{
						minImdb = ratingAns.get("text").toString();
					}
				}
				catch(ratingErr)
				{
					if(answers.get("minImdb") != null)
					{
						minImdb = answers.get("minImdb").toString();
					}
				}
			}
			if(answers.containsKey("year"))
			{
				try
				{
					yearAns = answers.get("year");
					if(yearAns != null)
					{
						year = yearAns.get("text").toString();
					}
				}
				catch(yearErr)
				{
					if(answers.get("year") != null)
					{
						year = answers.get("year").toString();
					}
				}
			}
			if(answers.containsKey("subject"))
			{
				try
				{
					subjectAns = answers.get("subject");
					if(subjectAns != null)
					{
						subject = subjectAns.get("text").toString();
					}
				}
				catch(subErr)
				{
					if(answers.get("subject") != null)
					{
						subject = answers.get("subject").toString();
					}
				}
			}
			if(answers.containsKey("keyword"))
			{
				try
				{
					keywordAns = answers.get("keyword");
					if(keywordAns != null)
					{
						keyword = keywordAns.get("text").toString();
					}
				}
				catch(keyErr)
				{
					if(answers.get("keyword") != null)
					{
						keyword = answers.get("keyword").toString();
					}
				}
			}
			if(answers.containsKey("diet"))
			{
				try
				{
					dietAns = answers.get("diet");
					if(dietAns != null)
					{
						diet = dietAns.get("text").toString();
					}
				}
				catch(dietErr)
				{
					if(answers.get("diet") != null)
					{
						diet = answers.get("diet").toString();
					}
				}
			}
			if(answers.containsKey("songType"))
			{
				try
				{
					songAns = answers.get("songType");
					if(songAns != null)
					{
						songType = songAns.get("text").toString();
					}
				}
				catch(songErr)
				{
					if(answers.get("songType") != null)
					{
						songType = answers.get("songType").toString();
					}
				}
			}
		}
		
		// If category is selected but preferences not collected, ask for them
		if(category.equalsIgnoreCase("movies") && genre == "")
		{
			response = Map();
			response.put("action","context");
			response.put("context_id","suggest_context");
			questions = Collection();
			
			q1 = Map();
			q1.put("name","genre");
			q1.put("replies",{"What genre are you in the mood for? (e.g., Action, Drama, Comedy)"});
			q1.put("suggestions",{"Action","Drama","Comedy","Thriller","Sci-Fi","Romance","Horror","Adventure","Surprise Me"});
			
			q2 = Map();
			q2.put("name","minImdb");
			q2.put("replies",{"Minimum IMDB rating? (e.g., 7.0, 8.0, or skip)"});
			q2.put("suggestions",{"7.0+","8.0+","8.5+","Any Rating","Skip"});
			
			q3 = Map();
			q3.put("name","year");
			q3.put("replies",{"Preferred release year? (e.g., 2020, 2015, or skip)"});
			q3.put("suggestions",{"2020+","2015+","2010+","Any Year","Skip"});
			
			questions.insert(q1);
			questions.insert(q2);
			questions.insert(q3);
			response.put("questions",questions);
			hasReturned = true;
			return response;
		}
		else if(category.equalsIgnoreCase("books") && subject == "")
		{
			response = Map();
			response.put("action","context");
			response.put("context_id","suggest_context");
			questions = Collection();
			
			q1 = Map();
			q1.put("name","subject");
			q1.put("replies",{"What kind of books interest you? (e.g., Fiction, Mystery, Biography)"});
			q1.put("suggestions",{"Fiction","Mystery","Biography","Self-Help","Sci-Fi","Romance","Thriller","Bestsellers","Surprise Me"});
			
			questions.insert(q1);
			response.put("questions",questions);
			hasReturned = true;
			return response;
		}
		else if(category.equalsIgnoreCase("games") && keyword == "")
		{
			response = Map();
			response.put("action","context");
			response.put("context_id","suggest_context");
			questions = Collection();
			
			q1 = Map();
			q1.put("name","keyword");
			q1.put("replies",{"What type of games do you enjoy? (e.g., Action, RPG, Strategy)"});
			q1.put("suggestions",{"Action","RPG","Strategy","Racing","Adventure","Horror","Sports","Popular Games","Surprise Me"});
			
			questions.insert(q1);
			response.put("questions",questions);
			hasReturned = true;
			return response;
		}
		else if(category.equalsIgnoreCase("food") && diet == "")
		{
			response = Map();
			response.put("action","context");
			response.put("context_id","suggest_context");
			questions = Collection();
			
			q1 = Map();
			q1.put("name","diet");
			q1.put("replies",{"Any dietary preferences?"});
			q1.put("suggestions",{"Veg","Non-Veg","Vegan","Keto","Any","Surprise Me"});
			
			questions.insert(q1);
			response.put("questions",questions);
			hasReturned = true;
			return response;
		}
		else if(category.equalsIgnoreCase("music") && songType == "")
		{
			response = Map();
			response.put("action","context");
			response.put("context_id","suggest_context");
			questions = Collection();
			
			q1 = Map();
			q1.put("name","songType");
			q1.put("replies",{"What music style do you prefer? (e.g., Pop, Rock, Hip-Hop)"});
			q1.put("suggestions",{"Pop","Rock","Hip-Hop","Lo-fi","Classical","EDM","Jazz","Country","Surprise Me"});
			
			questions.insert(q1);
			response.put("questions",questions);
			hasReturned = true;
			return response;
		}

		// Now build payload with collected preferences
		responseText = "Here are some " + category + " suggestions based on your preferences.";

		payload = Map();
		payload.put("category",category);
		prefs = Map();
		
		if(category.equalsIgnoreCase("movies"))
		{
			if(genre != "" && !genre.equalsIgnoreCase("skip") && !genre.equalsIgnoreCase("surprise me"))
			{
				prefs.put("genre",genre);
			}
			if(minImdb != "" && !minImdb.equalsIgnoreCase("skip") && !minImdb.equalsIgnoreCase("any rating"))
			{
				minImdbVal = minImdb.replaceAll("\\+","");
				minImdbVal = minImdbVal.replaceAll(" ","");
				prefs.put("minImdb",minImdbVal);
			}
			if(year != "" && !year.equalsIgnoreCase("skip") && !year.equalsIgnoreCase("any year"))
			{
				yearVal = year.replaceAll("\\+","");
				yearVal = yearVal.replaceAll(" ","");
				prefs.put("year",yearVal);
			}
		}
		else if(category.equalsIgnoreCase("books"))
		{
			if(subject != "" && !subject.equalsIgnoreCase("skip") && !subject.equalsIgnoreCase("surprise me"))
			{
				prefs.put("subject",subject);
			}
		}
		else if(category.equalsIgnoreCase("games"))
		{
			if(keyword != "" && !keyword.equalsIgnoreCase("skip") && !keyword.equalsIgnoreCase("surprise me"))
			{
				prefs.put("keyword",keyword);
			}
		}
		else if(category.equalsIgnoreCase("food"))
		{
			if(diet != "" && !diet.equalsIgnoreCase("skip") && !diet.equalsIgnoreCase("surprise me") && !diet.equalsIgnoreCase("any"))
			{
				prefs.put("diet",diet);
			}
		}
		else if(category.equalsIgnoreCase("music"))
		{
			if(songType != "" && !songType.equalsIgnoreCase("skip") && !songType.equalsIgnoreCase("surprise me"))
			{
				prefs.put("songType",songType);
			}
		}
		
		payload.put("prefs",prefs);
		apiResult = Map();
		apiSuccess = true;

		try
		{
			apiResult = invokeurl
			[
				url : "https://zorek.onrender.com/suggest_cards"
				type : POST
				parameters : payload
			];
			info "🟦 suggest_context API result " + apiResult;
		}
		catch(apiErrSuggest)
		{
			apiSuccess = false;
			info "🟥 suggest_context invokeurl error " + apiErrSuggest;
		}

		if(apiSuccess == false || apiResult == null || apiResult.isEmpty())
		{
			info "🟦 suggest_context using fallback cards due to API timeout/failure";
			cardCollection = Collection();
			if(category.equalsIgnoreCase("movies"))
			{
				fallbackCard = Map();
				fallbackCard.put("id","fallback_movies_" + zoho.currenttime.toLong());
				fallbackCard.put("title","Popular Movies");
				fallbackCard.put("subtitle","Check out trending movies on IMDb");
				actionList = Collection();
				actionMap = Map();
				actionMap.put("label","View Movies");
				actionMap.put("type","url");
				actionMap.put("name","fallback_movies_action");
				actionMap.put("link","https://www.imdb.com/chart/top/");
				actionList.insert(actionMap);
				fallbackCard.put("actions",actionList);
				cardCollection.insert(fallbackCard);
			}
			else if(category.equalsIgnoreCase("books"))
			{
				fallbackCard = Map();
				fallbackCard.put("id","fallback_books_" + zoho.currenttime.toLong());
				fallbackCard.put("title","Popular Books");
				fallbackCard.put("subtitle","Explore bestsellers on Goodreads");
				actionList = Collection();
				actionMap = Map();
				actionMap.put("label","View Books");
				actionMap.put("type","url");
				actionMap.put("name","fallback_books_action");
				actionMap.put("link","https://www.goodreads.com/genre/popular");
				actionList.insert(actionMap);
				fallbackCard.put("actions",actionList);
				cardCollection.insert(fallbackCard);
			}
			else
			{
				fallbackCard = Map();
				fallbackCard.put("id","fallback_search_" + zoho.currenttime.toLong());
				fallbackCard.put("title","Explore " + category);
				fallbackCard.put("subtitle","Discover more about " + category);
				actionList = Collection();
				actionMap = Map();
				actionMap.put("label","Search");
				actionMap.put("type","url");
				actionMap.put("name","fallback_search_action");
				actionMap.put("link","https://www.google.com/search?q=" + category);
				actionList.insert(actionMap);
				fallbackCard.put("actions",actionList);
				cardCollection.insert(fallbackCard);
			}
			response = Map();
			response.put("action","reply");
			replies = Collection();
			introReply = Map();
			introReply.put("text","Here are some quick " + category + " ideas:");
			replies.insert(introReply);
			optionNumbers = Collection();
			cardIndex = 1;
			for each card in cardCollection
			{
				try
				{
					if(card != null)
					{
						cardTitle = "";
						cardSubtitle = "";
						cardImage = "";
						cardUrl = "";
						if(card.containsKey("title"))
						{
							cardTitle = card.get("title").toString();
						}
						if(card.containsKey("subtitle"))
						{
							cardSubtitle = card.get("subtitle").toString();
						}
						if(card.containsKey("image") && card.get("image") != null)
						{
							imageVal = card.get("image").toString();
							if(imageVal != "" && imageVal != null && imageVal != "null")
							{
								cardImage = imageVal;
							}
						}
						if(card.containsKey("actions"))
						{
							actionsList = card.get("actions");
							if(actionsList != null && actionsList.size() > 0)
							{
								firstAction = actionsList.get(0);
								if(firstAction != null && firstAction.containsKey("link"))
								{
									urlVal = firstAction.get("link").toString();
									if(urlVal != "" && urlVal != null && urlVal != "null")
									{
										cardUrl = urlVal;
									}
								}
							}
						}
						replyText = cardIndex.toString() + ". " + cardTitle;
						if(cardSubtitle != "")
						{
							replyText = replyText + " - " + cardSubtitle;
						}
						if(cardUrl != "")
						{
							replyText = replyText + "\n🔗 " + cardUrl;
						}
						replyMap = Map();
						replyMap.put("text",replyText);
						if(cardImage != "")
						{
							replyMap.put("image",cardImage);
						}
						replies.insert(replyMap);
						optionNumbers.insert(cardIndex.toString());
						cardIndex = cardIndex + 1;
					}
				}
				catch(cardErr)
				{
					info "🟥 suggest_context fallback card error " + cardErr;
				}
			}
			selectReply = Map();
			selectReply.put("text","Select from given options");
			replies.insert(selectReply);
			response.put("replies",replies);
			selectInput = Map();
			selectInput.put("type","select");
			selectInput.put("options",optionNumbers);
			response.put("input",selectInput);
			response.put("suggestions",{"Movies","Books","Games","Food","Music"});
			hasReturned = true;
			return response;
		}

		cardCollection = Collection();
		cardsList = null;
		if(apiResult.containsKey("type") && apiResult.get("type").toString().equalsIgnoreCase("multiple-product") && apiResult.containsKey("elements"))
		{
			cardsList = apiResult.get("elements");
			info "🟦 suggest_context: Found Multiple Product format with " + cardsList.size() + " elements";
		}
		else if(apiResult.containsKey("cards"))
		{
			cardsList = apiResult.get("cards");
			info "🟦 suggest_context: Found legacy cards format with " + cardsList.size() + " cards";
		}
		if(apiResult.containsKey("text"))
		{
			try
			{
				responseText = apiResult.get("text").toString();
			}
			catch(textErr)
			{
				responseText = "Here are some " + category + " suggestions.";
			}
		}
		if(cardsList != null && cardsList.size() > 0)
		{
			cardCollection = cardsList;
		}

		info "🟦 suggest_context cards count " + cardCollection.size();

		if(cardCollection.size() == 0)
		{
			fallbackCard = Map();
			fallbackCard.put("id","fallback_empty_" + zoho.currenttime.toLong());
			fallbackCard.put("title","No Data");
			fallbackCard.put("subtitle","Please try another option.");
			actionList = Collection();
			actionMap = Map();
			actionMap.put("label","Retry");
			actionMap.put("type","url");
			actionMap.put("name","fallback_retry_action");
			actionMap.put("link","https://zorek.onrender.com");
			actionList.insert(actionMap);
			fallbackCard.put("actions",actionList);
			cardCollection.insert(fallbackCard);
		}

		if(cardCollection.size() > 0)
		{
			response = Map();
			response.put("action","reply");
			replies = Collection();
			introReply = Map();
			introReply.put("text",responseText);
			replies.insert(introReply);
			optionNumbers = Collection();
			cardIndex = 1;
			for each card in cardCollection
			{
				try
				{
					if(card != null)
					{
						cardTitle = "";
						cardSubtitle = "";
						cardImage = "";
						cardUrl = "";
						if(card.containsKey("title"))
						{
							cardTitle = card.get("title").toString();
						}
						if(card.containsKey("subtitle"))
						{
							cardSubtitle = card.get("subtitle").toString();
						}
						if(card.containsKey("image") && card.get("image") != null)
						{
							imageVal = card.get("image").toString();
							if(imageVal != "" && imageVal != null && imageVal != "null")
							{
								cardImage = imageVal;
							}
						}
						if(card.containsKey("actions"))
						{
							actionsList = card.get("actions");
							if(actionsList != null && actionsList.size() > 0)
							{
								firstAction = actionsList.get(0);
								if(firstAction != null && firstAction.containsKey("link"))
								{
									urlVal = firstAction.get("link").toString();
									if(urlVal != "" && urlVal != null && urlVal != "null")
									{
										cardUrl = urlVal;
									}
								}
							}
						}
						replyText = cardIndex.toString() + ". " + cardTitle;
						if(cardSubtitle != "")
						{
							replyText = replyText + " - " + cardSubtitle;
						}
						if(cardUrl != "")
						{
							replyText = replyText + "\n🔗 " + cardUrl;
						}
						replyMap = Map();
						replyMap.put("text",replyText);
						if(cardImage != "")
						{
							replyMap.put("image",cardImage);
						}
						replies.insert(replyMap);
						optionNumbers.insert(cardIndex.toString());
						cardIndex = cardIndex + 1;
					}
				}
				catch(cardErr)
				{
					info "🟥 suggest_context card error " + cardErr;
				}
			}
			selectReply = Map();
			selectReply.put("text","Select from given options");
			replies.insert(selectReply);
			response.put("replies",replies);
			selectInput = Map();
			selectInput.put("type","select");
			selectInput.put("options",optionNumbers);
			response.put("input",selectInput);
			suggestionOptions = Collection();
			suggestionOptions.insert("Suggest Something");
			suggestionOptions.insert("Book an Event");
			suggestionOptions.insert("My Pick Combo");
			suggestionOptions.insert("Connect with human");
			response.put("suggestions",suggestionOptions);
			info "🟦 suggest_context VALIDATING RESPONSE - action=" + response.get("action") + ", hasReplies=" + response.containsKey("replies") + ", repliesCount=" + replies.size() + ", hasSuggestions=" + response.containsKey("suggestions");
			info "🟦 suggest_context FULL RESPONSE: " + response;
			hasReturned = true;
			return response;
		}
		else
		{
			response = Map();
			response.put("action","reply");
			response.put("replies",{"No " + category + " suggestions found. Please try another category."});
			response.put("suggestions",{"Suggest Something","Book an Event","My Pick Combo","Connect with human"});
			info "🟦 suggest_context returning text reply (no cards)";
			hasReturned = true;
			return response;
		}
	}
	catch(suggestErr)
	{
		info "🟥 suggest_context fatal error " + suggestErr;
		response = Map();
		response.put("action","reply");
		response.put("replies",{"Sorry, something went wrong. Please try again."});
		response.put("suggestions",{"Suggest Something","Book an Event","My Pick Combo","Connect with human"});
		hasReturned = true;
		return response;
	}
}

// ---------------- Book an Event ----------------
if(context_id.equals("event_context"))
{
	try
	{
		info "🟩 event_context answers " + answers;
		eventType = "";
		cityValue = "";

		if(answers != null)
		{
			if(answers.containsKey("event_type"))
			{
				eventAnswer = answers.get("event_type");
				if(eventAnswer != null)
				{
					try
					{
						eventType = eventAnswer.get("text").toString();
					}
					catch(eventErr)
					{
						eventType = eventAnswer.toString();
					}
				}
			}
			if(answers.containsKey("city"))
			{
				cityAnswer = answers.get("city");
				if(cityAnswer != null)
				{
					try
					{
						cityValue = cityAnswer.get("text").toString();
					}
					catch(cityErr)
					{
						cityValue = cityAnswer.toString();
					}
				}
			}
		}

		if(eventType != null)
		{
			eventLower = eventType.toLowerCase();
			if(eventLower.contains("concert"))
			{
				eventType = "concerts";
			}
			else if(eventLower.contains("talk"))
			{
				eventType = "talkshow";
			}
			else if(eventLower.contains("movie"))
			{
				eventType = "movies";
			}
			else if(eventLower.contains("theater") || eventLower.contains("theatre"))
			{
				eventType = "theater";
			}
			else if(eventLower.contains("sport"))
			{
				eventType = "sports";
			}
			else if(eventLower.contains("find"))
			{
				eventType = "find events";
			}
		}

		if(cityValue == "" || cityValue == null)
		{
			cityValue = "Delhi";
		}
		info "🟩 event_context type/city " + eventType + " / " + cityValue;

