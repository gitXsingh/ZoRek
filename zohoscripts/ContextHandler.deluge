							img = card.get("image").toString();
							if(img != "" && img != "null")
							{
								cardImage = img;
							}
						}
						if(card.containsKey("actions"))
						{
							acts = card.get("actions");
							if(acts != null && acts.size() > 0)
							{
								act = acts.get(0);
								if(act != null && act.containsKey("link"))
								{
									url = act.get("link").toString();
									if(url != "" && url != "null")
									{
										cardUrl = url;
									}
								}
							}
						}
						replyText = cardIndex.toString() + ". " + cardTitle;
						if(cardSubtitle != "")
						{
							replyText = replyText + " - " + cardSubtitle;
						}
						if(cardUrl != "")
						{
							replyText = replyText + "\n" + cardUrl;
							cardUrlsMap.put(cardIndex.toString(),cardUrl);
						}
