			response = Map();
			response.put("action","reply");
			response.put("replies",{"No events found for " + eventType + " in " + cityValue + "."});
			response.put("suggestions",{"Book an Event","Suggest Something","My Pick Combo","Connect with human"});
			info "🟩 event_context returning text reply (no cards)";
			hasReturned = true;
			return response;
		}
	}
	catch(eventContextErr)
	{
		info "🟥 event_context fatal error " + eventContextErr;
		response = Map();
		response.put("action","reply");
		response.put("replies",{"Something went wrong while fetching events. Please try again."});
		response.put("suggestions",{"Book an Event","Suggest Something","My Pick Combo","Connect with human"});
		hasReturned = true;
		return response;
	}
}

// ---------------- Combo Context ----------------
if(context_id.equals("combo_context"))
{
	try
	{
		info "🟪 combo_context answers " + answers;
		moodValue = "";
		movieGenreValue = "";
		songTypeValue = "";
		dietValue = "";

	if(answers != null)
	{
		if(answers.containsKey("mood"))
		{
			moodAnswer = answers.get("mood");
			if(moodAnswer != null)
			{
				try
				{
					moodValue = moodAnswer.get("text").toString();
				}
				catch(moodErr)
				{
					moodValue = moodAnswer.toString();
				}
			}
		}
		if(answers.containsKey("movieGenre"))
		{
			movieAnswer = answers.get("movieGenre");
			if(movieAnswer != null)
			{
				try
				{
					movieGenreValue = movieAnswer.get("text").toString();
				}
				catch(movieErr)
				{
					movieGenreValue = movieAnswer.toString();
				}
			}
		}
		if(answers.containsKey("songType"))
		{
			songAnswer = answers.get("songType");
			if(songAnswer != null)
			{
				try
				{
					songTypeValue = songAnswer.get("text").toString();
				}
				catch(songErr)
				{
					songTypeValue = songAnswer.toString();
				}
			}
		}
		if(answers.containsKey("diet"))
		{
			dietAnswer = answers.get("diet");
			if(dietAnswer != null)
			{
				try
				{
					dietValue = dietAnswer.get("text").toString();
				}
				catch(dietErr)
				{
					dietValue = dietAnswer.toString();
				}
			}
		}
	}

		if(movieGenreValue != null && movieGenreValue.toLowerCase().contains("surprise"))
		{
			movieGenreValue = "random";
		}
		if(songTypeValue != null && songTypeValue.toLowerCase().equals("any"))
		{
			songTypeValue = "";
		}
		if(dietValue != null && dietValue.toLowerCase().equals("any"))
		{
			dietValue = "";
		}

		info "🟪 combo_context prefs mood/movie/song/diet = " + moodValue + "/" + movieGenreValue + "/" + songTypeValue + "/" + dietValue;

	responseText = "Here is your entertainment combo.";

	payload = Map();
	payload.put("mood",moodValue);
	payload.put("movieGenre",movieGenreValue);
	payload.put("songType",songTypeValue);
	payload.put("diet",dietValue);
	apiResult = Map();
	apiSuccess = true;

	try
	{
		apiResult = invokeurl
		[
			url : "https://zorek.onrender.com/recommendations"
			type : POST
			parameters : payload
		];
		info "🟪 combo_context API result " + apiResult;
	}
	catch(apiErrCombo)
	{
		apiSuccess = false;
		info "🟥 combo_context invokeurl error " + apiErrCombo;
	}

	if(apiSuccess == false || apiResult == null || apiResult.isEmpty())
	{
		info "🟪 combo_context using fallback cards due to API timeout/failure";
		cardCollection = Collection();
		movieCard = Map();
	movieCard.put("id","fallback_combo_movie_" + zoho.currenttime.toLong());
	movieCard.put("title","Movie Recommendation");
	movieCard.put("subtitle","Popular " + movieGenreValue + " movies");
	movieActions = Collection();
	movieAction = Map();
	movieAction.put("label","Watch Now");
	movieAction.put("type","url");
	movieAction.put("name","fallback_combo_movie_action");
	movieAction.put("link","https://www.imdb.com/search/title/?genres=" + movieGenreValue);
	movieActions.insert(movieAction);
	movieCard.put("actions",movieActions);
		cardCollection.insert(movieCard);
		
		songCard = Map();
	songCard.put("id","fallback_combo_song_" + zoho.currenttime.toLong());
	songCard.put("title",songTypeValue + " Playlist");
	songCard.put("subtitle","Curated " + songTypeValue + " music");
	songActions = Collection();
	songAction = Map();
	songAction.put("label","Listen");
	songAction.put("type","url");
	songAction.put("name","fallback_combo_song_action");
	songAction.put("link","https://open.spotify.com/search/" + songTypeValue);
	songActions.insert(songAction);
	songCard.put("actions",songActions);
		cardCollection.insert(songCard);
		
		foodCard = Map();
	foodCard.put("id","fallback_combo_food_" + zoho.currenttime.toLong());
	foodCard.put("title",dietValue + " Recipe");
	foodCard.put("subtitle","Delicious " + dietValue + " options");
	foodActions = Collection();
	foodAction = Map();
	foodAction.put("label","View Recipes");
	foodAction.put("type","url");
	foodAction.put("name","fallback_combo_food_action");
	foodAction.put("link","https://www.foodnetwork.com/search/" + dietValue);
	foodActions.insert(foodAction);
	foodCard.put("actions",foodActions);
		cardCollection.insert(foodCard);
		
		response = Map();
		response.put("action","reply");
	response.put("type","multiple-product");
	response.put("text","Here is a quick combo based on your picks.");
	response.put("elements",cardCollection);
		response.put("suggestions",{"My Pick Combo","Suggest Something","Book an Event","Connect with human"});
		info "🟪 combo_context returning response - action=" + response.get("action") + ", cards=" + cardCollection.size();
		hasReturned = true;
		return response;
	}

cardCollection = Collection();
cardsList = null;
if(apiResult.containsKey("type") && apiResult.get("type").toString().equalsIgnoreCase("multiple-product") && apiResult.containsKey("elements"))
{
