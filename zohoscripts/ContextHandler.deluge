	}

	if(cardCollection.size() > 0)
	{
		response = Map();
		response.put("action","reply");
	response.put("type","multiple-product");
	response.put("text",responseText);
	response.put("elements",cardCollection);
		suggestionOptions = Collection();
		suggestionOptions.insert("My Pick Combo");
		suggestionOptions.insert("Suggest Something");
		suggestionOptions.insert("Book an Event");
		suggestionOptions.insert("Connect with human");
		response.put("suggestions",suggestionOptions);
	info "🟪 combo_context VALIDATING RESPONSE - action=" + response.get("action") + ", hasElements=" + response.containsKey("elements") + ", cardsCount=" + cardCollection.size() + ", hasSuggestions=" + response.containsKey("suggestions");
		info "🟪 combo_context FULL RESPONSE: " + response;
		hasReturned = true;
		return response;
	}
	else
	{
		response = Map();
		response.put("action","reply");
		response.put("replies",{"I couldn't build a combo. Please adjust your preferences."});
		response.put("suggestions",{"My Pick Combo","Suggest Something","Book an Event","Connect with human"});
		info "🟪 combo_context returning text reply (no cards)";
		hasReturned = true;
		return response;
	}
	}
	catch(comboContextErr)
	{
		info "🟥 combo_context fatal error " + comboContextErr;
		response = Map();
		response.put("action","reply");
		response.put("replies",{"Unable to build a combo right now. Please try again later."});
		response.put("suggestions",{"My Pick Combo","Suggest Something","Book an Event","Connect with human"});
		hasReturned = true;
		return response;
	}
}

// ---------------- Default Fallback ----------------
if(!hasReturned)
{
	info "⚠️ ContextHandler: No matching context_id or no response returned, using default fallback";
	response = Map();
	response.put("action","reply");
	response.put("replies",{"I didn't understand that. Please choose an option."});
	response.put("suggestions",{"Suggest Something","Book an Event","My Pick Combo","Connect with human"});
	info "📤 ContextHandler: Returning default fallback response";
	hasReturned = true;
}

// Always return response (guaranteed to be set by now)
return response;
