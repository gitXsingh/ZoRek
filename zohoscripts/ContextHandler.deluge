			q1 = Map();
			q1.put("name","city");
			q1.put("replies",{"Which city should I search in? (e.g., Mumbai, Delhi)"});
			q1.put("suggestions",{"Mumbai","Delhi","Bengaluru","Hyderabad","Chennai","Pune","Kolkata","Ahmedabad","Jaipur","Lucknow","Surat","Nagpur","Indore","Bhopal","Visakhapatnam","Patna","Vadodara","Chandigarh","Coimbatore","Madurai","Kochi","Bhubaneswar","Ranchi","Dehradun","Udaipur"});
			questions.insert(q1);
			response.put("questions",questions);
			hasReturned = true;
			return response;
		}
