response = Map();
// extract message text from input
msg = "";
if(message != null && message.containsKey("text"))
{
	msg = message.get("text").toString().trim();
}

mainOptions = {"Suggest Something","Book an Event","My Pick Combo","Connect to Spotify","Connect with human"};

// handle empty message when chat starts
if(operation != null && operation.equalsIgnoreCase("chat") && msg == "")
{
	response.put("action","reply");
	response.put("replies",{"Hi again! Choose an option below to get started."});
	response.put("suggestions",mainOptions);
	return response;
}

// handle empty message
if(msg == "")
{
	response.put("action","reply");
	response.put("replies",{"I didn't catch that. Please pick an option."});
	response.put("suggestions",mainOptions);
	return response;
}

// route to appropriate context based on user message
if(msg.equalsIgnoreCase("Suggest Something"))
{
	response.put("action","context");
	response.put("context_id","suggest_context");
	questions = Collection();
	q = Map();
	q.put("name","category");
	q.put("replies",{"Pick what you feel like discovering today."});
	q.put("suggestions",{"Movies","Books","Games","Food","Music","Surprise Me"});
	questions.insert(q);
	response.put("questions",questions);
	return response;
}
else if(msg.equalsIgnoreCase("Book an Event"))
{
	response.put("action","context");
	response.put("context_id","event_context");
	questions = Collection();
	q1 = Map();
	q1.put("name","event_type");
	q1.put("replies",{"What kind of outing do you have in mind?"});
	q1.put("suggestions",{"Movies (Now Playing)","Concerts","Talkshow","Theater","Sports","Find Events"});
	q2 = Map();
	q2.put("name","city");
	q2.put("replies",{"Which city should I search in? (e.g., Mumbai, Delhi)"});
	q2.put("suggestions",{"Mumbai","Delhi","Bengaluru","Hyderabad","Chennai","Pune","Kolkata","Ahmedabad","Jaipur","Lucknow","Surat","Nagpur","Indore","Thane","Bhopal","Visakhapatnam","Patna","Vadodara","Ghaziabad","Ludhiana","Agra","Nashik","Faridabad","Meerut","Rajkot","Varanasi","Srinagar","Amritsar","Noida","Ranchi","Chandigarh","Raipur","Gwalior","Jodhpur","Coimbatore","Madurai","Vijayawada","Solapur","Tiruchirappalli","Bareilly","Moradabad","Mysore","Tiruppur","Gurgaon","Aligarh","Jalandhar","Bhubaneswar","Salem","Warangal","Guntur","Bhiwandi","Saharanpur","Gorakhpur","Bikaner","Amravati","Jamshedpur","Bhilai","Cuttack","Firozabad","Kochi","Nellore","Bhavnagar","Dehradun","Durgapur","Asansol","Rourkela","Nanded","Kolhapur","Ajmer","Gulbarga","Jamnagar","Ujjain","Loni","Siliguri","Jhansi","Ulhasnagar","Jammu","Sangli-Miraj","Mangalore","Erode","Belgaum","Ambattur","Tirunelveli","Malegaon","Gaya","Jalgaon","Udaipur","Maheshtala","Davangere","Kozhikode","Akola","Kurnool","Rajahmundry","Bokaro","South Dumdum","Bellary","Patiala","Gopalpur","Agartala","Bhagalpur","Muzaffarnagar","Bhatpara","Panihati","Latur","Dhule","Rohtak","Korba","Bilaspur","Muzaffarpur","Ahmednagar","Mathura","Kollam","Avadi","Kadapa","Kamptee","Sambalpur","Shahjahanpur","Satara","Rampur","Shivamogga","Chandrapur","Junagadh","Thrissur","Alwar","Bardhaman","Kulti","Kakinada","Nizamabad","Parbhani","Tumkur","Khammam","Ozhukarai","Bihar Sharif","Panipat","Darbhanga","Bally","Aizawl","Dewas","Ichalkaranji","Tirupati","Karnal","Bathinda","Jalna","Barasat","Kirari Suleman Nagar","Purnia","Satna","Mau","Sonipat","Farrukhabad","Sagar","Durg","Imphal","Ratlam","Hapur","Anantapur","Arrah","Karimnagar","Etawah","Bharatpur","Begusarai","New Delhi","Chhapra","Buxar","Jehanabad","Phusro","Dindigul","Gandhinagar","Baranagar","Tiruvottiyur","Puducherry","Sikar","Thoothukudi","Rewa","Mirzapur","Raichur","Pali","Khora","Vejalpur","Kottayam","Gangtok","Thiruvananthapuram","Port Blair","Kavaratti","Daman","Diu","Silvassa","Panaji","Shillong","Aizawl","Itanagar","Kohima","Imphal","Agartala","Dispur"});
	questions.insert(q1);
	questions.insert(q2);
	response.put("questions",questions);
	return response;
}
else if(msg.equalsIgnoreCase("My Pick Combo"))
{
	response.put("action","context");
	response.put("context_id","combo_context");
	questions = Collection();
	qMood = Map();
	qMood.put("name","mood");
	qMood.put("replies",{"What's your mood right now?"});
	qMood.put("suggestions",{"Happy","Chill","Romantic","Energetic","Mystery","Adventurous"});
	qMovie = Map();
	qMovie.put("name","movieGenre");
	qMovie.put("replies",{"Preferred movie vibe? (e.g., Action, Drama)"});
	qMovie.put("suggestions",{"Action","Drama","Comedy","Thriller","Sci-Fi","Surprise Me"});
	qSong = Map();
	qSong.put("name","songType");
	qSong.put("replies",{"Preferred song style? (e.g., Pop, Rock)"});
	qSong.put("suggestions",{"Pop","Rock","Hip-Hop","Lo-fi","Classical","EDM"});
	qDiet = Map();
	qDiet.put("name","diet");
	qDiet.put("replies",{"Diet preference?"});
	qDiet.put("suggestions",{"Veg","Non-Veg","Vegan","Keto","Any"});
	questions.insert(qMood);
	questions.insert(qMovie);
	questions.insert(qSong);
	questions.insert(qDiet);
	response.put("questions",questions);
	return response;
}
else if(msg.equalsIgnoreCase("Connect to Spotify"))
{
	response.put("action","reply");
	spotifyUrl = "https://zorek.onrender.com/oauth/spotify/start";
	response.put("replies",{"Connect to Spotify to get better music recommendations and direct track links.","Click here to connect: " + spotifyUrl});
	response.put("suggestions",mainOptions);
	return response;
}
else if(msg.equalsIgnoreCase("Connect with human"))
{
	response.put("action","forward");
	response.put("replies",{"Connecting you to an operator..."});
	response.put("department","Sales");
	return response;
}
else if(msg.equalsIgnoreCase("End chat"))
{
	response.put("action","end");
	response.put("replies",{"Thanks for chatting with ZoRek. See you soon!"});
	return response;
}

// check if user selected a card number
isNumber = false;
selectedNumber = 0;
if(msg != "" && msg.length() <= 2)
{
	try
	{
		selectedNumber = msg.toNumber();
		if(selectedNumber >= 1 && selectedNumber <= 10)
		{
			isNumber = true;
		}
	}
	catch(numErr)
	{
		isNumber = false;
	}
}

// retrieve card url from session if number was selected
if(isNumber)
{
	response = Map();
	response.put("action","reply");
	selectedUrl = "";
	try
	{
		portalName = "";
		if(request != null && request.containsKey("portal_name"))
		{
			portalName = request.get("portal_name").toString();
		}
		else if(request != null && request.containsKey("portalName"))
		{
			portalName = request.get("portalName").toString();
		}
		if(portalName != "" && portalName != null)
		{
			cardUrlsData = zoho.salesiq.visitorsession.get(portalName,"zorek_cards");
			if(cardUrlsData != null && cardUrlsData.containsKey("data"))
			{
				sessionData = cardUrlsData.get("data");
				if(sessionData != null && sessionData.containsKey("zorek_cards"))
				{
					cardUrlsMap = sessionData.get("zorek_cards");
					if(cardUrlsMap != null && cardUrlsMap.containsKey(selectedNumber.toString()))
					{
						selectedUrl = cardUrlsMap.get(selectedNumber.toString()).toString();
					}
				}
			}
		}
	}
	catch(sessionErr)
	{
	}
	if(selectedUrl != "" && selectedUrl != null)
	{
		response.put("replies",{"Great choice! Here's the direct link:\n" + selectedUrl + "\n\nFeel free to explore more options below."});
	}
	else
	{
		response.put("replies",{"Thanks for your selection! Feel free to explore more options below or pick another category."});
	}
	response.put("suggestions",mainOptions);
	return response;
}

response = Map();
response.put("action","reply");
response.put("replies",{"Please choose an option to continue."});
response.put("suggestions",mainOptions);
return response;
